{
  "description": "CIDR containment test vectors. Each case tests whether an IP is contained in a CIDR range.",
  "cases": [
    {"cidr": "10.0.0.0/8", "ip": "10.0.0.1", "expected": true, "note": "RFC1918 class A"},
    {"cidr": "10.0.0.0/8", "ip": "10.255.255.255", "expected": true, "note": "last in range"},
    {"cidr": "10.0.0.0/8", "ip": "11.0.0.0", "expected": false, "note": "first outside"},
    {"cidr": "10.0.0.0/8", "ip": "9.255.255.255", "expected": false, "note": "just before"},
    {"cidr": "172.16.0.0/12", "ip": "172.16.0.1", "expected": true, "note": "RFC1918 class B start"},
    {"cidr": "172.16.0.0/12", "ip": "172.31.255.255", "expected": true, "note": "RFC1918 class B end"},
    {"cidr": "172.16.0.0/12", "ip": "172.32.0.0", "expected": false, "note": "first outside"},
    {"cidr": "192.168.0.0/16", "ip": "192.168.0.1", "expected": true, "note": "RFC1918 class C"},
    {"cidr": "192.168.0.0/16", "ip": "192.168.255.255", "expected": true, "note": "last in range"},
    {"cidr": "192.168.0.0/16", "ip": "192.169.0.0", "expected": false, "note": "first outside"},
    {"cidr": "127.0.0.0/8", "ip": "127.0.0.1", "expected": true, "note": "loopback"},
    {"cidr": "127.0.0.0/8", "ip": "127.255.255.255", "expected": true, "note": "loopback end"},
    {"cidr": "169.254.0.0/16", "ip": "169.254.169.254", "expected": true, "note": "link-local contains IMDS"},
    {"cidr": "169.254.169.254/32", "ip": "169.254.169.254", "expected": true, "note": "IMDS exact"},
    {"cidr": "169.254.169.254/32", "ip": "169.254.169.253", "expected": false, "note": "IMDS off-by-one below"},
    {"cidr": "169.254.169.254/32", "ip": "169.254.169.255", "expected": false, "note": "IMDS off-by-one above"},
    {"cidr": "169.254.170.2/32", "ip": "169.254.170.2", "expected": true, "note": "ECS metadata exact"},
    {"cidr": "169.254.170.2/32", "ip": "169.254.170.1", "expected": false, "note": "ECS off-by-one below"},
    {"cidr": "169.254.170.2/32", "ip": "169.254.170.3", "expected": false, "note": "ECS off-by-one above"},
    {"cidr": "168.63.129.16/32", "ip": "168.63.129.16", "expected": true, "note": "Azure Wireserver exact"},
    {"cidr": "168.63.129.16/32", "ip": "168.63.129.15", "expected": false, "note": "Azure off-by-one"},
    {"cidr": "100.64.0.0/10", "ip": "100.64.0.1", "expected": true, "note": "CGNAT first"},
    {"cidr": "100.64.0.0/10", "ip": "100.127.255.255", "expected": true, "note": "CGNAT last"},
    {"cidr": "100.64.0.0/10", "ip": "100.128.0.0", "expected": false, "note": "CGNAT first outside"},
    {"cidr": "198.18.0.0/15", "ip": "198.18.0.1", "expected": true, "note": "benchmark first"},
    {"cidr": "198.18.0.0/15", "ip": "198.19.255.255", "expected": true, "note": "benchmark last"},
    {"cidr": "198.18.0.0/15", "ip": "198.20.0.0", "expected": false, "note": "benchmark outside"},
    {"cidr": "0.0.0.0/0", "ip": "1.2.3.4", "expected": true, "note": "/0 matches any IPv4"},
    {"cidr": "0.0.0.0/0", "ip": "255.255.255.255", "expected": true, "note": "/0 matches broadcast"},
    {"cidr": "::1/128", "ip": "::1", "expected": true, "note": "IPv6 loopback exact"},
    {"cidr": "::1/128", "ip": "::2", "expected": false, "note": "IPv6 loopback off-by-one"},
    {"cidr": "fe80::/10", "ip": "fe80::1", "expected": true, "note": "IPv6 link-local"},
    {"cidr": "fe80::/10", "ip": "febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff", "expected": true, "note": "link-local last"},
    {"cidr": "fe80::/10", "ip": "fec0::1", "expected": false, "note": "just outside link-local"},
    {"cidr": "fc00::/7", "ip": "fc00::1", "expected": true, "note": "ULA start"},
    {"cidr": "fc00::/7", "ip": "fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff", "expected": true, "note": "ULA end"},
    {"cidr": "fc00::/7", "ip": "fe00::1", "expected": false, "note": "just outside ULA"},
    {"cidr": "2002::/16", "ip": "2002:c0a8:1::1", "expected": true, "note": "6to4 wrapping 192.168.1.x"},
    {"cidr": "2002::/16", "ip": "2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff", "expected": true, "note": "6to4 last"},
    {"cidr": "2002::/16", "ip": "2003::1", "expected": false, "note": "outside 6to4"},
    {"cidr": "2001::/32", "ip": "2001::1", "expected": true, "note": "Teredo"},
    {"cidr": "2001::/32", "ip": "2001:0000:ffff:ffff:ffff:ffff:ffff:ffff", "expected": true, "note": "Teredo last"},
    {"cidr": "2001::/32", "ip": "2001:0001::1", "expected": false, "note": "outside Teredo"},
    {"cidr": "64:ff9b::/96", "ip": "64:ff9b::1.2.3.4", "expected": true, "note": "NAT64 well-known wrapping IPv4"},
    {"cidr": "64:ff9b::/96", "ip": "64:ff9b::c0a8:1", "expected": true, "note": "NAT64 wrapping 192.168.0.1"},
    {"cidr": "64:ff9b::/96", "ip": "64:ff9b:1::1", "expected": false, "note": "outside NAT64 well-known"},
    {"cidr": "64:ff9b:1::/48", "ip": "64:ff9b:1::1", "expected": true, "note": "NAT64 local-use"},
    {"cidr": "64:ff9b:1::/48", "ip": "64:ff9b:2::1", "expected": false, "note": "outside NAT64 local"},
    {"cidr": "fd00:ec2::254/128", "ip": "fd00:ec2::254", "expected": true, "note": "AWS IMDSv2 IPv6 exact"},
    {"cidr": "fd00:ec2::254/128", "ip": "fd00:ec2::253", "expected": false, "note": "AWS IMDSv2 off-by-one"},
    {"cidr": "2001:db8::/32", "ip": "2001:db8::1", "expected": true, "note": "documentation prefix"},
    {"cidr": "100::/64", "ip": "100::1", "expected": true, "note": "discard-only"},
    {"cidr": "192.168.0.0/16", "ip": "::ffff:192.168.1.1", "expected": true, "note": "IPv4-mapped IPv6 containment"}
  ]
}
