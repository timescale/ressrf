      "expected": "allowed",
      "note": "Secure WebSocket scheme allowed (control case)"
    },
    {
      "name": "control_public_with_port",
      "category": "control",
      "url": "https://example.com:8443/path",
      "expected": "allowed",
      "note": "Public URL with explicit port"
    },
    {
      "name": "control_public_with_userinfo_no_bypass",
      "category": "control",
      "url": "https://user:pass@example.com/",
      "expected": "allowed",
      "note": "Legitimate userinfo (no %40 bypass)"
    },
    {
      "name": "control_trusted_suffix_match",
      "category": "control",
      "url": "https://api.example.com/v1/data",
      "trusted_suffixes": ["example.com"],
      "expected": "allowed",
      "note": "Allowlisted domain"
    },
    {
      "name": "control_trusted_suffix_boundary_no_match",
      "category": "control",
      "url": "https://notexample.com/",
      "trusted_suffixes": ["example.com"],
      "expected": "blocked",
      "reason_type": "domain_not_in_allow_list",
      "note": "Boundary-aware match: notexample.com != suffix example.com"
    },
    {
      "name": "fragment_after_imds_does_not_save",
      "category": "url_parser_confusion",
      "url": "http://169.254.169.254#expected.example.com",
      "expected": "blocked",
      "reason_type": "bare_ip_denied_before_scheme",
      "note": "Fragment after host does not change the host"
    },
    {
      "name": "fragment_after_userinfo_imds",
      "category": "url_parser_confusion",
      "url": "http://expected.example.com#@169.254.169.254/",
      "expected": "allowed",
      "note": "# starts a fragment; host stays expected.example.com (no userinfo before #)"
    },
    {
      "name": "scheme_only_with_garbage",
      "category": "url_parser_confusion",
      "url": "evil:something",
      "expected": "blocked",
      "reason_type": "scheme_not_allowed",
      "note": "Anything with a leading scheme: prefix rejected"
    },
    {
      "name": "empty_host_after_scheme",
      "category": "url_parser_confusion",
      "url": "http:///path",
      "expected": "blocked",
      "reason_type": "url_parse_error",
      "note": "Empty host between // and / produces UrlParseError"
    },
    {
      "name": "control_public_ipv6_allowed",
      "category": "ipv6_notation",
      "url": "http://[2606:4700:4700::1111]/",
      "expected": "allowed",
      "note": "Cloudflare DNS IPv6 (control case)"
    }
  ]
}
