{
  "description": "Policy decision test vectors. Tests the full policy engine with different presets and configurations.",
  "cases": [
    {
      "name": "external_only_blocks_private_ipv4",
      "preset": "external_only",
      "ips": ["10.0.0.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_loopback",
      "preset": "external_only",
      "ips": ["127.0.0.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_link_local",
      "preset": "external_only",
      "ips": ["169.254.1.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_imds",
      "preset": "external_only",
      "ips": ["169.254.169.254"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_ecs_metadata",
      "preset": "external_only",
      "ips": ["169.254.170.2"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_azure_wireserver",
      "preset": "external_only",
      "ips": ["168.63.129.16"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_cgnat",
      "preset": "external_only",
      "ips": ["100.64.0.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_allows_public",
      "preset": "external_only",
      "ips": ["8.8.8.8"],
      "expected": "allowed"
    },
    {
      "name": "external_only_allows_public_2",
      "preset": "external_only",
      "ips": ["1.1.1.1"],
      "expected": "allowed"
    },
    {
      "name": "external_only_blocks_ipv6_loopback",
      "preset": "external_only",
      "ips": ["::1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_ipv6_link_local",
      "preset": "external_only",
      "ips": ["fe80::1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_ipv6_ula",
      "preset": "external_only",
      "ips": ["fd00::1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_6to4",
      "preset": "external_only",
      "ips": ["2002:c0a8:1::1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_teredo",
      "preset": "external_only",
      "ips": ["2001:0000:1234::1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_blocks_nat64",
      "preset": "external_only",
      "ips": ["64:ff9b::192.168.1.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "external_only_allows_public_ipv6",
      "preset": "external_only",
      "ips": ["2607:f8b0:4004:800::200e"],
      "expected": "allowed"
    },
    {
      "name": "allow_overrides_deny",
      "preset": "external_only",
      "allow": ["10.42.0.0/16"],
      "ips": ["10.42.1.1"],
      "expected": "allowed"
    },
    {
      "name": "allow_override_does_not_extend",
      "preset": "external_only",
      "allow": ["10.42.0.0/16"],
      "ips": ["10.0.0.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    },
    {
      "name": "internal_only_blocks_unlisted",
      "preset": "internal_only",
      "allow": ["203.0.113.0/24"],
      "ips": ["8.8.8.8"],
      "expected": "blocked",
      "reason_type": "not_in_allow_list"
    },
    {
      "name": "internal_only_allows_listed",
      "preset": "internal_only",
      "allow": ["203.0.113.0/24"],
      "ips": ["203.0.113.1"],
      "expected": "allowed"
    },
    {
      "name": "none_preset_allows_everything",
      "preset": "none",
      "ips": ["10.0.0.1"],
      "expected": "allowed"
    },
    {
      "name": "empty_ips_rejected",
      "preset": "external_only",
      "ips": [],
      "expected": "blocked",
      "reason_type": "dns_empty_response"
    },
    {
      "name": "multi_ip_all_must_pass",
      "preset": "external_only",
      "ips": ["8.8.8.8", "10.0.0.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr",
      "note": "second IP is private"
    },
    {
      "name": "multi_ip_all_public_passes",
      "preset": "external_only",
      "ips": ["8.8.8.8", "8.8.4.4"],
      "expected": "allowed"
    },
    {
      "name": "ipv4_mapped_ipv6_blocked",
      "preset": "external_only",
      "ips": ["::ffff:10.0.0.1"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr",
      "note": "IPv4-mapped IPv6 form of private address"
    },
    {
      "name": "aws_imdsv2_ipv6_blocked",
      "preset": "external_only",
      "ips": ["fd00:ec2::254"],
      "expected": "blocked",
      "reason_type": "in_deny_cidr"
    }
  ]
}
