# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Fuzz corpus and artifacts (keep seed corpus committed, ignore runtime)
fuzz/artifacts/
fuzz/corpus/*
!fuzz/corpus/.gitkeep

# Python build artifacts
python/target/
*.so
*.dylib
*.whl
__pycache__/
*.egg-info/

# Node.js
node/node_modules/
node/dist/

# WASM build artifacts
*.wasm
!go/ressrf/core.wasm
!node/core.wasm

.cursor/
